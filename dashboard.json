# 3. homey dashboard.js

Créer un HomeyScript nommé :

```text
homey dashboard.js
```

Puis coller :

```javascript
const devices = await Homey.devices.getDevices();
const logic = await Homey.logic.getVariables();

function getDevice(id) {
  return devices[id];
}

function getBatteryState(power) {

  if (power > 100) return 'CHARGE';
  if (power < -100) return 'DECHARGE';

  return 'IDLE';
}

const BATTERIES = [
  {
    id: 'b2302309-a297-4732-9f9f-54aed7cb311f',
    name: 'Batterie_1'
  },
  {
    id: '0d3db87e-f2e2-42ee-818e-fe1eda72ea31',
    name: 'Batterie_2'
  },
  {
    id: 'fe7d4c65-1650-463f-b417-5431fb35bf1d',
    name: 'Batterie_3'
  },
  {
    id: '7cae1822-f159-4d81-a071-c078589fb74b',
    name: 'Batterie_4'
  }
];

const batteries = [];

for (const battery of BATTERIES) {

  const device = getDevice(battery.id);

  const soc = device.capabilitiesObj.measure_battery?.value || 0;
  const power = device.capabilitiesObj.measure_power_ongrid?.value || 0;

  batteries.push({
    soc,
    power,
    state: getBatteryState(power)
  });
}

const tempo = getDevice('9a4727a2-0c1f-46be-8d79-6a39a7a0960b');

const weatherToday = getDevice('b70c3da4-9984-46b6-9a1d-573ba62b097f');
const weatherTomorrow = getDevice('ce82a85d-ddc2-4579-b1fe-8bd3f2919993');

const shelly = getDevice('ddfe018e-5628-4a32-8aeb-07a9d8cc8f9d');

const solarVariable = Object.values(logic).find(v => v.name === 'Production Solaire');

const payload = {
  tempo: {
    today: tempo.capabilitiesObj.tempo_today.value,
    tomorrow: tempo.capabilitiesObj.tempo_tomorrow.value
  },

  weather: {
    today: {
      description: weatherToday.capabilitiesObj.description.value
    },
    tomorrow: {
      description: 'Prévisions demain'
    }
  },

  solar: Math.round((solarVariable.value || 0) * 1000),

  grid: Math.round(
    shelly.capabilitiesObj.measure_power.value || 0
  ),

  batteries
};

console.log(JSON.stringify(payload, null, 2));

return true;
```


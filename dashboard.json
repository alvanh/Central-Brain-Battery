    <div class="card">
      <div class="label">Batterie 2</div>
      <div class="value" id="bat2soc">0%</div>
      <div class="status" id="bat2status">IDLE</div>
      <div class="battery-bar">
        <div class="battery-fill" id="bat2fill" style="width:0%"></div>
      </div>
    </div>

    <div class="card">
      <div class="label">Batterie 3</div>
      <div class="value" id="bat3soc">0%</div>
      <div class="status" id="bat3status">IDLE</div>
      <div class="battery-bar">
        <div class="battery-fill" id="bat3fill" style="width:0%"></div>
      </div>
    </div>

    <div class="card">
      <div class="label">Batterie 4</div>
      <div class="value" id="bat4soc">0%</div>
      <div class="status" id="bat4status">IDLE</div>
      <div class="battery-bar">
        <div class="battery-fill" id="bat4fill" style="width:0%"></div>
      </div>
    </div>

  </div>

<script>
async function loadData() {

  const response = await fetch('dashboard.json?t=' + Date.now());
  const data = await response.json();

  document.getElementById('tempoToday').innerText = data.tempo.today;
  document.getElementById('tempoTomorrow').innerText = data.tempo.tomorrow;

  document.getElementById('weatherTodayText').innerText = data.weather.today.description;
  document.getElementById('weatherTomorrowText').innerText = data.weather.tomorrow.description;

  document.getElementById('solarPower').innerText = data.solar + ' W';
  document.getElementById('gridPower').innerText = data.grid + ' W';

  data.batteries.forEach((bat, index) => {

    const i = index + 1;

    document.getElementById(`bat${i}soc`).innerText = bat.soc + '%';
    document.getElementById(`bat${i}status`).innerText = bat.state;
    document.getElementById(`bat${i}fill`).style.width = bat.soc + '%';
  });
}

loadData();
setInterval(loadData, 10000);
</script>

</body>
</html>
